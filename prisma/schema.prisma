generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id               String         @id @default(uuid())
  email            String         @unique
  phone            String?        @unique
  password         String?
  name             String
  role             Role           @default(PATIENT)
  isVerified       Boolean        @default(false)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  resetToken       String?        @unique
  resetTokenExpiry DateTime?
  lastLogin        DateTime?
  status           UserStatus     @default(ACTIVE)
  loginOtp         String?
  otpExpiry        DateTime?
  addresses        Address[]
  auditLogs        AuditLog[]
  authLogs         AuthLog[]
  deviceTokens     DeviceToken[]
  doctor           Doctor?
  lab              Lab?
  notifications    Notification[]
  patients         Patient[]
  userRoles        UserRole[]
  wallet           Wallet?

  @@index([email])
  @@index([phone])
  @@map("users")
}

model Patient {
  id                    String           @id @default(uuid())
  userId                String
  name                  String?
  dateOfBirth           DateTime?
  gender                Gender?
  bloodGroup            String?
  height                Float?
  weight                Float?
  allergies             String?
  chronicDiseases       String?
  emergencyContactName  String?
  emergencyContactPhone String?
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt
  profilePic            String?
  appointments          Appointment[]
  favoriteDoctors       FavoriteDoctor[]
  insurance             Insurance?
  labReports            LabReport[]
  medicalRecords        MedicalRecord[]
  docs                  Docs[]
  user                  User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  prescriptions         Prescription[]
  reviews               Review[]
  waitlist              Waitlist[]

  @@map("patients")
}

model Docs {
  id            String       @id @default(uuid())
  patientId     String
  title         String
  description   String?
  category      String?
  fileUrl       String
  sizeMb        Float?
  uploadedBy    String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  appointmentId String?
  labId         String?
  doctorId      String?
  appointment   Appointment? @relation(fields: [appointmentId], references: [id])
  doctor        Doctor?      @relation(fields: [doctorId], references: [id])
  lab           Lab?         @relation(fields: [labId], references: [id])
  patient       Patient      @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@map("patient_docs")
}

model Doctor {
  id                          String               @id @default(uuid())
  userId                      String               @unique
  licenseNumber               String?
  bio                         String?
  experienceYears             Int?
  consultationFee             Float?
  qualification               String?
  clinicPhone                 String?
  timeZone                    String               @default("UTC")
  averageRating               Float                @default(0.0)
  totalReviews                Int                  @default(0)
  createdAt                   DateTime             @default(now())
  updatedAt                   DateTime             @updatedAt
  clinicName                  String?
  hospitalName                String?
  isProfileComplete           Boolean              @default(false)
  permissions                 String[]             @default(["profile"])
  profileCompletionPercentage Int                  @default(0)
  associationProof            String?
  idProof                     String?
  profilePhoto                String?
  clinicImages                String[]             @default([])
  bankName                    String?
  accountHolderName           String?
  accountNumber               String?
  ifscCode                    String?
  appointments                Appointment[]
  campaigns                   Campaign[]
  availability                DoctorAvailability[]
  leaves                      DoctorLeave[]
  user                        User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  favoritedBy                 FavoriteDoctor[]
  referredReports             LabReport[]
  medicalRecords              MedicalRecord[]
  docs                        Docs[]
  prescriptions               Prescription[]
  reviews                     Review[]
  waitlist                    Waitlist[]
  specializations             Specialization[]     @relation("DoctorToSpecialization")

  @@map("doctors")
}

model Campaign {
  id                         String         @id @default(uuid())
  doctorId                   String?
  name                       String         @map("campaign_name")
  description                String?
  type                       CampaignType   @map("campaign_type")
  status                     CampaignStatus @default(IN_REVIEW)
  price                      Float
  currency                   String         @default("INR")
  discountPercentage         Float          @default(0.0) @map("discount_percentage")
  location                   Json
  startDate                  DateTime       @map("start_date")
  endDate                    DateTime       @map("end_date")
  schedule                   Json
  bookingRules               Json           @map("booking_rules")
  eligibility                Json
  stats                      Json?
  media                      Json?
  isVerified                 Boolean        @default(false)
  createdAt                  DateTime       @default(now()) @map("created_at")
  updatedAt                  DateTime       @updatedAt @map("updated_at")
  dailyLimit                 Int            @default(0) @map("daily_limit")
  hourlyLimit                Int            @default(0) @map("hourly_limit")
  requiredDetails            String[]       @default([]) @map("required_details")
  totalCapacity              Int?           @map("total_capacity")
  gender                     String?
  healthConcern              String[]       @default([]) @map("health_concern")
  isFreeHomeSampleCollection Boolean        @default(false) @map("is_free_home_sample_collection")
  labId                      String?
  reportTime                 String?        @map("report_time")
  testCategory               String[]       @default([]) @map("test_category")
  testsIncluded              String[]       @default([]) @map("tests_included")
  doctor                     Doctor?        @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  lab                        Lab?           @relation(fields: [labId], references: [id], onDelete: Cascade)

  @@index([doctorId])
  @@index([labId])
  @@map("campaigns")
}

model Lab {
  id                          String            @id @default(uuid())
  userId                      String            @unique
  licenseNumber               String?
  description                 String?
  website                     String?
  averageRating               Float             @default(0.0)
  totalReviews                Int               @default(0)
  createdAt                   DateTime          @default(now())
  updatedAt                   DateTime          @updatedAt
  testTypes                   String[]          @default([])
  isProfileComplete           Boolean           @default(false)
  permissions                 String[]          @default(["profile"])
  profileCompletionPercentage Int               @default(0)
  addressProof                String?
  ownerIdProof                String?
  profilePhoto                String?
  addresses                   Address[]
  appointments                Appointment[]
  campaigns                   Campaign[]
  availability                LabAvailability[]
  tests                       LabTest[]
  user                        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  docs                        Docs[]
  reviews                     Review[]

  @@map("labs")
}

model Specialization {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  image       String?
  doctors     Doctor[] @relation("DoctorToSpecialization")

  @@map("specializations")
}

model DoctorAvailability {
  id        String    @id @default(uuid())
  doctorId  String
  dayOfWeek DayOfWeek
  startTime String
  endTime   String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  doctor    Doctor    @relation(fields: [doctorId], references: [id])

  @@map("doctor_availabilities")
}

model Appointment {
  id                 String            @id @default(uuid())
  patientId          String
  doctorId           String?
  labId              String?
  labTestId          String?
  dateTime           DateTime
  status             AppointmentStatus @default(PENDING)
  consultationFee    Float             @default(0.0)
  version            Int               @default(0)
  duration           Int               @default(30)
  type               AppointmentType   @default(IN_PERSON)
  videoLink          String?
  meetingPassword    String?
  cancelledBy        String?
  cancellationReason String?
  cancelledAt        DateTime?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  doctor             Doctor?           @relation(fields: [doctorId], references: [id])
  lab                Lab?              @relation(fields: [labId], references: [id])
  labTest            LabTest?          @relation(fields: [labTestId], references: [id])
  patient            Patient           @relation(fields: [patientId], references: [id])
  docs               Docs[]
  payment            Payment?
  prescription       Prescription?

  @@index([doctorId])
  @@index([patientId])
  @@index([dateTime])
  @@map("appointments")
}

model MedicalRecord {
  id          String       @id @default(uuid())
  patientId   String
  doctorId    String
  diagnosis   String?
  notes       String?
  fileUrl     String?
  date        DateTime     @default(now())
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  attachments Attachment[]
  doctor      Doctor       @relation(fields: [doctorId], references: [id])
  patient     Patient      @relation(fields: [patientId], references: [id])
  vitalSigns  VitalSigns?

  @@map("medical_records")
}

model Prescription {
  id            String       @id @default(uuid())
  patientId     String
  doctorId      String
  appointmentId String?      @unique
  notes         String?
  date          DateTime     @default(now())
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  medications   Medication[]
  appointment   Appointment? @relation(fields: [appointmentId], references: [id])
  doctor        Doctor       @relation(fields: [doctorId], references: [id])
  patient       Patient      @relation(fields: [patientId], references: [id])

  @@map("prescriptions")
}

model Medication {
  id             String       @id @default(uuid())
  prescriptionId String
  name           String
  dosage         String?
  frequency      String?
  duration       String?
  instructions   String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  prescription   Prescription @relation(fields: [prescriptionId], references: [id])

  @@map("medications")
}

model Review {
  id        String   @id @default(uuid())
  patientId String
  doctorId  String?
  labId     String?
  rating    Int
  comment   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  doctor    Doctor?  @relation(fields: [doctorId], references: [id])
  lab       Lab?     @relation(fields: [labId], references: [id])
  patient   Patient  @relation(fields: [patientId], references: [id])

  @@map("reviews")
}

model FavoriteDoctor {
  id        String   @id @default(uuid())
  patientId String
  doctorId  String
  createdAt DateTime @default(now())
  doctor    Doctor   @relation(fields: [doctorId], references: [id])
  patient   Patient  @relation(fields: [patientId], references: [id])

  @@unique([patientId, doctorId])
  @@map("favorite_doctors")
}

model Notification {
  id             String              @id @default(uuid())
  userId         String
  title          String
  message        String
  isRead         Boolean             @default(false)
  type           String?
  channel        NotificationChannel @default(IN_APP)
  deliveryStatus DeliveryStatus      @default(QUEUED)
  externalId     String?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  user           User                @relation(fields: [userId], references: [id])

  @@map("notifications")
}

model SystemSetting {
  id          String   @id @default(uuid())
  key         String   @unique
  value       String
  description String?
  updatedAt   DateTime @updatedAt

  @@map("system_settings")
}

model Payment {
  id            String        @id @default(uuid())
  appointmentId String        @unique
  amount        Float
  status        PaymentStatus @default(PENDING)
  method        String?
  transactionId String?
  refundId      String?
  refundedAt    DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  appointment   Appointment   @relation(fields: [appointmentId], references: [id])

  @@map("payments")
}

model LabTest {
  id           String        @id @default(uuid())
  labId        String
  name         String
  description  String?
  price        Float
  duration     String?
  bundleId     String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  appointments Appointment[]
  reports      LabReport[]
  includedIn   LabTest?      @relation("LabTestBundles", fields: [bundleId], references: [id])
  includes     LabTest[]     @relation("LabTestBundles")
  lab          Lab           @relation(fields: [labId], references: [id])

  @@map("lab_tests")
}

model LabReport {
  id        String       @id @default(uuid())
  testId    String
  patientId String
  doctorId  String?
  fileUrl   String?
  status    ReportStatus @default(PENDING)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  doctor    Doctor?      @relation(fields: [doctorId], references: [id])
  patient   Patient      @relation(fields: [patientId], references: [id])
  test      LabTest      @relation(fields: [testId], references: [id])

  @@map("lab_reports")
}

model Address {
  id        String   @id @default(uuid())
  userId    String?
  labId     String?
  label     String?
  isDefault Boolean  @default(false)
  street    String?
  city      String
  state     String
  zipCode   String
  country   String   @default("India")
  latitude  Float?
  longitude Float?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  lab       Lab?     @relation(fields: [labId], references: [id])
  user      User?    @relation(fields: [userId], references: [id])

  @@map("addresses")
}

model Wallet {
  id           String        @id @default(uuid())
  userId       String        @unique
  balance      Float         @default(0.0)
  currency     String        @default("INR")
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  transactions Transaction[]
  user         User          @relation(fields: [userId], references: [id])

  @@map("wallets")
}

model Transaction {
  id          String            @id @default(uuid())
  walletId    String
  amount      Float
  type        TransactionType
  status      TransactionStatus @default(PENDING)
  description String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  wallet      Wallet            @relation(fields: [walletId], references: [id])

  @@map("transactions")
}

model Insurance {
  id              String    @id @default(uuid())
  patientId       String    @unique
  provider        String
  policyNumber    String
  coverageDetails String?
  validTill       DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  patient         Patient   @relation(fields: [patientId], references: [id])

  @@map("insurances")
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  action    String
  details   String?
  ipAddress String?
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id])

  @@map("audit_logs")
}

model AccessRole {
  id          String           @id @default(uuid())
  name        String           @unique
  description String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  permissions RolePermission[]
  users       UserRole[]

  @@map("access_roles")
}

model Permission {
  id          String           @id @default(uuid())
  action      String           @unique
  description String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  roles       RolePermission[]

  @@map("permissions")
}

model RolePermission {
  id           String     @id @default(uuid())
  roleId       String
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  role         AccessRole @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@map("role_permissions")
}

model UserRole {
  id        String     @id @default(uuid())
  userId    String
  roleId    String
  createdAt DateTime   @default(now())
  role      AccessRole @relation(fields: [roleId], references: [id], onDelete: Cascade)
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@map("user_roles")
}

model DoctorLeave {
  id        String   @id @default(uuid())
  doctorId  String
  startDate DateTime
  endDate   DateTime
  reason    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  doctor    Doctor   @relation(fields: [doctorId], references: [id], onDelete: Cascade)

  @@index([doctorId])
  @@map("doctor_leaves")
}

model Attachment {
  id              String         @id @default(uuid())
  url             String
  type            String
  medicalRecordId String?
  createdAt       DateTime       @default(now())
  medicalRecord   MedicalRecord? @relation(fields: [medicalRecordId], references: [id])

  @@map("attachments")
}

model VitalSigns {
  id              String        @id @default(uuid())
  medicalRecordId String        @unique
  heartRate       Int?
  systolic        Int?
  diastolic       Int?
  temperature     Float?
  respiratoryRate Int?
  spO2            Int?
  weight          Float?
  height          Float?
  bmi             Float?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  medicalRecord   MedicalRecord @relation(fields: [medicalRecordId], references: [id], onDelete: Cascade)

  @@map("vital_signs")
}

model Waitlist {
  id            String         @id @default(uuid())
  patientId     String
  doctorId      String
  preferredDate DateTime
  status        WaitlistStatus @default(ACTIVE)
  priority      Int            @default(0)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  doctor        Doctor         @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  patient       Patient        @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([doctorId, preferredDate])
  @@map("waitlists")
}

model LabAvailability {
  id        String    @id @default(uuid())
  labId     String
  dayOfWeek DayOfWeek
  startTime String
  endTime   String
  capacity  Int       @default(10)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  lab       Lab       @relation(fields: [labId], references: [id])

  @@map("lab_availabilities")
}

model AuthLog {
  id             String      @id @default(uuid())
  userId         String
  type           AuthLogType
  deviceType     String?
  os             String?
  osVersion      String?
  browser        String?
  browserVersion String?
  country        String?
  region         String?
  city           String?
  timezone       String?
  ipCountry      String?
  ipAddress      String?
  createdAt      DateTime    @default(now())
  user           User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("auth_logs")
}

model DeviceToken {
  id           String   @id @default(uuid())
  userId       String
  token        String   @unique
  platform     Platform
  lastActiveAt DateTime @default(now())
  createdAt    DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("device_tokens")
}

model Ticket {
  id        String       @id @default(uuid())
  name      String
  email     String
  phone     String
  subject   String
  message   String
  status    TicketStatus @default(OPEN)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@map("tickets")
}

model PageView {
  id         String   @id @default(uuid())
  sessionId  String?
  userId     String?
  path       String
  referrer   String?
  deviceType String?
  os         String?
  browser    String?
  country    String?
  city       String?
  createdAt  DateTime @default(now())
  campaignId String?
  metadata   Json?
  visitorId  String?

  @@index([path])
  @@index([createdAt])
  @@index([visitorId])
  @@map("page_views")
}

model AnalyticsEvent {
  id         String   @id @default(uuid())
  sessionId  String?
  userId     String?
  eventType  String
  eventValue String?
  path       String
  createdAt  DateTime @default(now())
  campaignId String?
  metadata   Json?
  visitorId  String?

  @@index([eventType])
  @@index([path])
  @@index([visitorId])
  @@map("analytics_events")
}

enum UserStatus {
  PENDING
  ACTIVE
  BLOCKED
  ARCHIVED
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  CLOSED
  ARCHIVED
}

enum Role {
  SUPER_ADMIN
  ADMIN
  DOCTOR
  PATIENT
  LAB
  PHARMACY
}

enum CampaignType {
  OPD
  HEALTH_CAMP
  FREE_CHECKUP
  HEALTH_CHECKUP_CAMP
  DISCOUNTED_TESTS
  HOME_COLLECTION_DRIVE
  COMMUNITY_SCREENING
}

enum CampaignStatus {
  DRAFT
  ACTIVE
  IN_REVIEW
  PAUSED
  COMPLETED
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
}

enum ReportStatus {
  PENDING
  COMPLETED
  CANCELLED
}

enum TransactionType {
  CREDIT
  DEBIT
}

enum TransactionStatus {
  PENDING
  SUCCESS
  FAILED
}

enum WaitlistStatus {
  ACTIVE
  NOTIFIED
  BOOKED
  EXPIRED
  CANCELLED
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
  RESCHEDULED
}

enum AppointmentType {
  VIDEO
  IN_PERSON
  LAB_WALK_IN
  LAB_HOME_COLLECTION
}

enum AuthLogType {
  SIGN_IN
  SIGN_UP
}

enum NotificationChannel {
  IN_APP
  EMAIL
  SMS
  PUSH
}

enum DeliveryStatus {
  QUEUED
  SENT
  FAILED
  DELIVERED
}

enum DayOfWeek {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum Platform {
  IOS
  ANDROID
  WEB
}
