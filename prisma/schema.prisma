// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  ADMIN
  DOCTOR
  PATIENT
  LAB
  PHARMACY
}

model User {
  id          String   @id @default(uuid())
  email       String   @unique
  phone       String?  @unique
  password    String
  name        String
  role        Role     @default(PATIENT)
  isVerified  Boolean  @default(false)
  status      Boolean  @default(true) // For soft delete or banning
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  patient     Patient?
  doctor      Doctor?
  lab         Lab?
  
  notifications Notification[]
  address       Address?
  wallet        Wallet?

  auditLogs     AuditLog[]

  @@index([email])
  @@index([phone])
  @@map("users")
}

model Patient {
  id            String   @id @default(uuid())
  userId        String   @unique
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  dateOfBirth   DateTime?
  gender        Gender?
  bloodGroup    String?
  height        Float?   // in cm
  weight        Float?   // in kg
  allergies     String?
  chronicDiseases String?
  
  appointments  Appointment[]
  medicalRecords MedicalRecord[]
  prescriptions Prescription[]
  
  insurance     Insurance?
  
  reviews       Review[]
  favoriteDoctors FavoriteDoctor[]
  labReports    LabReport[]
  
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("patients")
}

model Doctor {
  id              String   @id @default(uuid())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  licenseNumber   String?
  bio             String?
  experienceYears Int?
  consultationFee Float?
  qualification   String?
  
  specializations Specialization[]

  availability     DoctorAvailability[]
  appointments     Appointment[]
  medicalRecords   MedicalRecord[]
  prescriptions    Prescription[]
  reviews          Review[]
  favoritedBy      FavoriteDoctor[]
  referredReports  LabReport[]

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("doctors")
}

model Lab {
  id              String   @id @default(uuid())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  licenseNumber   String?
  description     String?
  website         String?

  address         Address?

  reviews         Review[]
  tests           LabTest[]

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("labs")
}

model Specialization {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  icon        String?

  doctors     Doctor[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("specializations")
}

model DoctorAvailability {
  id        String    @id @default(uuid())
  doctorId  String
  doctor    Doctor    @relation(fields: [doctorId], references: [id])
  
  dayOfWeek DayOfWeek
  startTime String    // Format HH:mm
  endTime   String    // Format HH:mm
  
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@map("doctor_availabilities")
}

model Appointment {
  id              String            @id @default(uuid())
  patientId       String
  patient         Patient           @relation(fields: [patientId], references: [id])
  doctorId        String
  doctor          Doctor            @relation(fields: [doctorId], references: [id])
  
  dateTime        DateTime
  status          AppointmentStatus @default(PENDING)
  reason          String?
  
  consultationFee Float    @default(0.0) // Locked-in price
  
  type            AppointmentType   @default(IN_PERSON)

  prescription    Prescription?
  payment         Payment?
  
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@index([doctorId])
  @@index([patientId])
  @@index([dateTime])
  @@map("appointments")
}

model MedicalRecord {
  id        String   @id @default(uuid())
  patientId String
  patient   Patient  @relation(fields: [patientId], references: [id])
  doctorId  String
  doctor    Doctor   @relation(fields: [doctorId], references: [id])
  
  diagnosis String?
  notes     String?
  fileUrl   String?
  
  date      DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("medical_records")
}

model Prescription {
  id             String       @id @default(uuid())
  patientId      String
  patient        Patient      @relation(fields: [patientId], references: [id])
  doctorId       String
  doctor         Doctor       @relation(fields: [doctorId], references: [id])
  appointmentId  String?      @unique
  appointment    Appointment? @relation(fields: [appointmentId], references: [id])
  
  medications    Medication[]
  notes          String?
  
  date           DateTime     @default(now())
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@map("prescriptions")
}

model Medication {
  id             String       @id @default(uuid())
  prescriptionId String
  prescription   Prescription @relation(fields: [prescriptionId], references: [id])
  
  name           String
  dosage         String?
  frequency      String?
  duration       String?
  instructions   String?
  
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@map("medications")
}

model Review {
  id        String   @id @default(uuid())
  patientId String
  patient   Patient  @relation(fields: [patientId], references: [id])
  doctorId  String?
  doctor    Doctor?  @relation(fields: [doctorId], references: [id])
  labId     String?
  lab       Lab?     @relation(fields: [labId], references: [id])
  
  rating    Int
  comment   String?
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("reviews")
}

model FavoriteDoctor {
  id        String   @id @default(uuid())
  patientId String
  patient   Patient  @relation(fields: [patientId], references: [id])
  doctorId  String
  doctor    Doctor   @relation(fields: [doctorId], references: [id])
  
  createdAt DateTime @default(now())

  @@unique([patientId, doctorId])
  @@map("favorite_doctors")
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  
  title     String
  message   String
  isRead    Boolean  @default(false)
  type      String?  // e.g. "APPOINTMENT", "SYSTEM", "PROMOTION"
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("notifications")
}

model SystemSetting {
  id          String   @id @default(uuid())
  key         String   @unique
  value       String
  description String?
  
  updatedAt   DateTime @updatedAt

  @@map("system_settings")
}

model Payment {
  id              String        @id @default(uuid())
  appointmentId   String        @unique
  appointment     Appointment   @relation(fields: [appointmentId], references: [id])
  
  amount          Float
  status          PaymentStatus @default(PENDING)
  method          String?       // "CARD", "UPI", "CASH"
  transactionId   String?
  
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@map("payments")
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
}

model LabTest {
  id          String   @id @default(uuid())
  labId       String
  lab         Lab      @relation(fields: [labId], references: [id])
  
  name        String
  description String?
  price       Float
  duration    String?  // e.g. "24 hours"
  
  reports     LabReport[]
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("lab_tests")
}

model LabReport {
  id          String   @id @default(uuid())
  testId      String
  test        LabTest  @relation(fields: [testId], references: [id])
  patientId   String
  patient     Patient  @relation(fields: [patientId], references: [id])
  doctorId    String?
  doctor      Doctor?  @relation(fields: [doctorId], references: [id])
  
  fileUrl     String?
  status      ReportStatus @default(PENDING)
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("lab_reports")
}

enum ReportStatus {
  PENDING
  COMPLETED
  CANCELLED
}

model Address {
  id        String   @id @default(uuid())
  userId    String?  @unique
  user      User?    @relation(fields: [userId], references: [id])
  labId     String?  @unique
  lab       Lab?     @relation(fields: [labId], references: [id])
  
  street    String?
  city      String
  state     String
  zipCode   String
  country   String   @default("India")
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("addresses")
}

model Wallet {
  id        String   @id @default(uuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id])
  
  balance   Float    @default(0.0)
  currency  String   @default("INR")
  
  transactions Transaction[]
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("wallets")
}

model Transaction {
  id            String   @id @default(uuid())
  walletId      String
  wallet        Wallet   @relation(fields: [walletId], references: [id])
  
  amount        Float
  type          TransactionType
  status        TransactionStatus @default(PENDING)
  description   String?
  
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("transactions")
}

enum TransactionType {
  CREDIT
  DEBIT
}

enum TransactionStatus {
  PENDING
  SUCCESS
  FAILED
}

model Insurance {
  id              String   @id @default(uuid())
  patientId       String   @unique
  patient         Patient  @relation(fields: [patientId], references: [id])
  
  provider        String
  policyNumber    String
  coverageDetails String?
  validTill       DateTime?
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("insurances")
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  
  action    String
  details   String?
  ipAddress String?
  
  createdAt DateTime @default(now())

  @@map("audit_logs")
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
  RESCHEDULED
}

enum AppointmentType {
  VIDEO
  IN_PERSON
}

enum DayOfWeek {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

